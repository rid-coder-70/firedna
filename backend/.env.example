# FireDNA Backend Configuration

# Application
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="FireDNA API"
ADMIN_KEY=""

# NASA FIRMS API (Get a free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# Leave empty to enable DEMO MODE with synthetic, scientifically realistic Bangladesh data
FIRMS_MAP_KEY=""

# Database
# Production (PostgreSQL + PostGIS):
# DATABASE_URL=postgresql://firedna:firedna_secret@localhost:5432/firedna
# Local Development / Default (SQLite fallback with Spatial indexing simulation):
DATABASE_URL=sqlite:///./firedna.db

# Processing Defaults
DEFAULT_GRID_RESOLUTION_DEG=0.1
DEFAULT_TEMPORAL_WINDOW_HOURS=24
HAI_COUNT_WEIGHT=0.40
HAI_FRP_WEIGHT=0.45
HAI_CONFIDENCE_WEIGHT=0.15

# Anomaly Thresholds
ANOMALY_ELEVATED_Z=1.5
ANOMALY_HIGH_Z=2.5
ANOMALY_EXTREME_Z=3.5
MIN_BASELINE_YEARS=3

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://firedna.vercel.app"]
